# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

.vscode

.python-version

# Benchmark working directories: suite input data, database files and scratch space. All are
# regenerable with `olap prepare` / `olap benchmark` and far too large for git.
**/temp
**/data

# Local result revisions. No results database is committed: revisions produced on another host
# travel as assets on the `runs` release (`olap results upload` / `olap results fetch`), so only
# the directory marker is kept.
/results/*
!/results/shared/
!/results/shared/.gitkeep
/results/shared/*.db

.claude

# Frontend (site/): `**/data` above would otherwise ignore the small manifests the web app reads
# (manifest.json, queries.json, suites.json), and site/src/lib holds generated but committed code.
# site/dist is build output and stays ignored by the `dist/` rule above.
!site/src/lib/
!site/public/data/

# The published results database ships as the `data` release asset rather than being committed:
# it is large, rewritten on every publish, and git would keep every version forever.
# `olap publish --upload` replaces the asset; `bun run fetch-data` retrieves it for a build.
site/public/data/results.db
site/public/data/results.db.wal
