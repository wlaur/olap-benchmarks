{
  "name": "olap-benchmarks",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "check": "tsc --noEmit",
    "codegen": "node ./scripts/generate-db-types.mjs && oxfmt --write src/lib/generated/db.ts",
    "dev": "vite",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint .",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "verify": "bun run check && bun run lint && bun run fmt:check && bun run build"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@coji/kysely-duckdb-wasm": "^0.4.0",
    "@duckdb/duckdb-wasm": "^1.32.0",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-select": "^2.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "kysely": "^0.29.2",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "duckdb": "^1.4.4",
    "oxfmt": "0.57.0",
    "oxlint": "1.72.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.3"
  }
}
