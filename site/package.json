{
  "name": "olap-benchmarks",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsgo && vite build",
    "check": "tsgo --noEmit",
    "codegen": "kysely-migrate codegen && node ./scripts/fix-kysely-codegen.mjs",
    "codegen:fix": "node ./scripts/fix-kysely-codegen.mjs",
    "dev": "vite",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.2",
    "@codemirror/state": "^6.5.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.39.17",
    "@coji/kysely-duckdb-wasm": "^0.3.0",
    "@duckdb/duckdb-wasm": "^1.29.0",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-select": "^2.2.6",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "kysely": "^0.28.11",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "recharts": "^2.15.3",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@20chan/kysely-duckdb": "^0.1.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "latest",
    "@vitejs/plugin-react": "^4.4.1",
    "duckdb": "^1.4.4",
    "kysely-migrate": "^0.0.16",
    "oxfmt": "0.38.0",
    "oxlint": "1.53.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.4"
  }
}
