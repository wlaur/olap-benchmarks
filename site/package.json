{
  "name": "olap-benchmarks",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsgo && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "fmt": "oxfmt --write src/",
    "fmt:check": "oxfmt --check src/",
    "check": "tsgo --noEmit",
    "codegen": "kysely-migrate codegen && node ./scripts/fix-kysely-codegen.mjs",
    "codegen:fix": "node ./scripts/fix-kysely-codegen.mjs"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.29.0",
    "@radix-ui/react-select": "^2.2.6",
    "@tanstack/react-table": "^8.21.3",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^2.15.3"
  },
  "devDependencies": {
    "@20chan/kysely-duckdb": "^0.1.0",
    "@coji/kysely-duckdb-wasm": "^0.3.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "latest",
    "@vitejs/plugin-react": "^4.4.1",
    "duckdb": "^1.4.4",
    "kysely": "^0.28.11",
    "kysely-migrate": "^0.0.16",
    "oxfmt": "^0.1.0",
    "oxlint": "^1.1.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.4"
  }
}
