{
  "name": "olap-benchmarks",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "check": "tsc --noEmit",
    "codegen": "node ./scripts/generate-db-types.mjs",
    "codegen:check": "node ./scripts/generate-db-types.mjs --check",
    "dev": "vite",
    "fetch-data": "curl -fL --create-dirs -o public/data/results.db https://github.com/wlaur/olap-benchmarks/releases/download/data/results.db",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint .",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "verify": "bun run check && bun run lint && bun run fmt:check && bun run build",
    "verify-data": "node ./scripts/verify-data.mjs"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@coji/kysely-duckdb-wasm": "^0.4.0",
    "@duckdb/duckdb-wasm": "^1.32.0",
    "@lezer/highlight": "^1.2.5",
    "@radix-ui/react-select": "^2.4.1",
    "@tailwindcss/typography": "^0.5.20",
    "clsx": "^2.1.1",
    "kysely": "^0.29.7",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "duckdb": "^1.4.4",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
